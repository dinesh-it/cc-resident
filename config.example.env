# cc-resident configuration. Copy to config.env (gitignored) and edit.
# Plain KEY=value lines; $HOME is expanded. Re-run ./install.sh after changes.

# Name shown for this machine in the Claude app (Code tab) and claude.ai/code
RC_NAME=my-machine

# tmux session the agent runs in (attach with: tmux attach -t <name>)
TMUX_SESSION=cc-resident

# --- Telegram channel (official telegram plugin) -----------------------------
# 1 = run a Claude Code session that you can chat with from Telegram
TELEGRAM_ENABLED=1
# Private folder for the bot token and allowlist. Only the agent session is
# pointed here, so other Claude sessions on this machine can't grab the bot.
TELEGRAM_STATE_DIR=$HOME/.config/cc-resident/telegram
# Telegram user ids allowed to talk to the agent (space separated).
# Everyone listed can approve commands on this machine, so keep it to yourself.
# The first id also receives bin/notify messages.
TELEGRAM_ALLOW_IDS=

# --- Notifications ----------------------------------------------------------
# Every message your own scripts send to the chat is appended here, so the
# agent can answer follow-ups like "what is this?". Use bin/notify to send,
# or bin/notify --log-only if your script sends to Telegram by itself.
NOTIFY_LOG=$HOME/.local/state/cc-resident/notifications.jsonl

# Telegram messages on shutdown / boot / unexpected agent stop (1 = on)
POWER_NOTIFY=1

# --- Status ------------------------------------------------------------------
# systemd units and docker containers checked by bin/status.sh, the
# SessionStart hook and the "back up" message
WATCH_UNITS="ssh docker"
WATCH_CONTAINERS=""

# Fresh session every day at this time (memory files carry over); empty = off
DAILY_RESTART=04:30
